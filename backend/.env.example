# BranchFlow Environment Configuration
# Copy this file to .env and adjust variables as needed

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (SQLite by default)
DATABASE_URL=sqlite:///./branchflow.db

# Google Gemini AI API Key
# Get your free key at https://aistudio.google.com/
# If left empty, BranchFlow will run in high-fidelity Demo / Heuristic AI Mode
GEMINI_API_KEY=

# Gemini Model
GEMINI_MODEL=gemini-1.5-flash

# n8n Automation Webhook (Optional)
# Configure to trigger external workflows on event creation / task updates
N8N_WEBHOOK_URL=
N8N_ENABLED=false
